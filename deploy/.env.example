# Football Betting System - Docker Deployment Secrets
# Copy this to .env and fill in actual values

# MySQL
MYSQL_ROOT_PASSWORD=your_mysql_password
MYSQL_DATABASE=football_betting

# API Service
WECHAT_APPID=your_wechat_appid
WECHAT_SECRET=your_wechat_secret
JWT_SECRET_KEY=your_jwt_secret_key

# Claude AI (AWS Bedrock)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# API-SPORTS / API-Football v3
API_SPORTS_KEY=your_api_sports_key

# Bzzoiro Sports Data（基本面弹窗）
BSD_API_TOKEN=your_bsd_api_token
